# Optional local settings. Copy to .env only if it does not exist; never commit .env.
APP_NAME=enterprise-workflow-agent
APP_ENV=development
APP_DEBUG=false

# Stage 03 persistence demo and migrations. Use your own local role and password.
# DATABASE_URL=postgresql+psycopg://enterprise_workflow:change-me@127.0.0.1:5432/enterprise_workflow

# Stage 09 outbox worker. The URL must be http(s) on 127.0.0.1 or [::1].
# Generate the secret (32+ characters) locally and give the receiver the same one:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# SANDBOX_WEBHOOK_URL=http://127.0.0.1:8010/webhook
# SANDBOX_WEBHOOK_SECRET=

# Integration tests read TEST_DATABASE_URL only from the process environment,
# never from .env. Its database name must end in _test; tests drop its schema.
